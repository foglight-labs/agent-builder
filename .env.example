OPENROUTER_API_KEY=
# Optional; defaults to anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=

# Optional. When set, each /api/recommend call is also written as
# <RUN_LOG_DIR>/<run_id>.json, in addition to the stdout log line.
# RUN_LOG_DIR=runs

# Hosted Meilisearch instance backing the skills catalog. The index is
# populated and maintained externally; this app only reads from it.
MEILISEARCH_HOST=https://search.foglight.co
MEILISEARCH_API_KEY=
# Optional; defaults to "skills"
MEILISEARCH_INDEX=
