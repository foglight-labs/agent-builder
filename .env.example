OPENROUTER_API_KEY=
# Optional; defaults to anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=

# Access wall. "open" (default) is fully public and needs nothing below.
# "invite" walls the UI, /api/recommend, /api/search, and /api/mcp behind
# Google/email sign-in plus an allowlist (see supabase/README.md).
ACCESS_MODE=open

# Public URL of this deployment. Required in invite mode and must match
# site_url in supabase/config.toml (locally: http://localhost:3000).
SITE_URL=http://localhost:3000

# Supabase project, Settings → API. The publishable key only; no secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# "You're in" emails via Resend. Optional: without a key, sends are logged.
RESEND_API_KEY=
# Optional; defaults to "Foglight <hello@foglight.co>"
EMAIL_FROM=

# Shared secret between the database trigger and /api/webhooks/access-granted
# (stored in Supabase Vault as access_webhook_secret).
ACCESS_WEBHOOK_SECRET=

# Optional. When set, each /api/recommend call is also written as
# <RUN_LOG_DIR>/<run_id>.json, in addition to the stdout log line.
# RUN_LOG_DIR=runs

# Hosted Meilisearch instance backing the skills catalog. The index is
# populated and maintained externally; this app only reads from it.
MEILISEARCH_HOST=https://search.foglight.co
MEILISEARCH_API_KEY=
# Optional; defaults to "skills"
MEILISEARCH_INDEX=
