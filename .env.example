OPENROUTER_API_KEY=
# Optional; defaults to anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=

# Read-only Postgres connection (see db/schema.sql for the skills_reader role).
# Local:
DATABASE_URL=postgres://skills_reader:CHANGE_ME@localhost:5432/skills
# Supabase (transaction pooler, IPv4-friendly):
# DATABASE_URL=postgres://skills_reader.<project-ref>:CHANGE_ME@aws-<region>.pooler.supabase.com:6543/postgres?sslmode=require
